# Copy to app-config.env (gitignored) and set per cluster, then:
#   make app-config ENV=prod
#
# Not consumed by kustomize: the overlay deliberately has no configMapGenerator,
# because Argo CD renders from git and would fail on a file it cannot see.
# Non-secret values only — NUXT_PUBLIC_* is served to every browser.
# Real secrets go in a Secret via External Secrets; see docs/security.md.
NUXT_PUBLIC_IS_STAGING=false
