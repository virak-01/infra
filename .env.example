# Copy to .env and fill in. .env is gitignored; this template is committed.
#
#   cp .env.example .env
#
# TERRAFORM DOES NOT READ .env. Nothing does, automatically — a .env file is a
# convention, not a mechanism. Load it one of these ways:
#
#   ./script/with-aws-env.sh terraform -chdir=terraform/infra plan     (this repo)
#   set -a; . ./.env; set +a; terraform -chdir=terraform/infra plan    (any shell)
#   direnv allow                                                       (if you use direnv)
#
# THE VARIABLE NAMES BELOW ARE NOT ARBITRARY. The AWS SDK reads exactly these, and
# nothing else — AWS_KEY and AWS_SECRET, for example, are silently ignored, so
# Terraform falls through to ~/.aws/credentials and either uses the wrong account or
# fails with "no valid credential sources found". A working .env with the wrong names
# looks identical to no .env at all.

# =============================================================================
# OPTION 1 — A NAMED PROFILE. Prefer this.
# =============================================================================
#
# Nothing secret lives in this file, because the credentials stay in
# ~/.aws/credentials where the SDK already manages them. If your organisation uses
# SSO, this is also the only option that works, since SSO issues short-lived
# credentials the SDK refreshes on its own.
#
#   aws configure --profile k8s-admin
#   aws sso login --profile k8s-admin        # if using SSO
#
# Uncomment ONE of option 1 or option 2 — setting both means the static keys win and
# the profile is ignored, which is confusing to debug.

AWS_PROFILE=k8s-admin

# =============================================================================
# OPTION 2 — STATIC KEYS. Works everywhere, ages badly.
# =============================================================================
#
# A long-lived access key is a credential that never expires until someone revokes
# it. If you use these, rotate them on a schedule and never paste them anywhere but
# this file.
#
# Comment out AWS_PROFILE above before uncommenting these.

# Placeholders are deliberately NOT the canonical example key from the AWS docs (the
# one beginning AKIA and ending EXAMPLE). That string matches the pattern every secret
# scanner looks for, so a committed copy produces a false positive in gitleaks,
# trufflehog and GitHub secret scanning — and an alert people learn to ignore is worse
# than no alert at all. This comment avoids spelling it out for the same reason.
# AWS_ACCESS_KEY_ID=<your-access-key-id>
# AWS_SECRET_ACCESS_KEY=<your-secret-access-key>

# TEMPORARY CREDENTIALS ONLY. Required alongside the two above when they came from
# `aws sts assume-role`, `aws sts get-session-token`, or SSO — an access key id
# starting ASIA rather than AKIA is temporary and WILL NOT WORK without this line.
# Omitting it produces "The security token included in the request is invalid",
# which sounds like a bad key rather than a missing third value.
#
# AWS_SESSION_TOKEN=

# =============================================================================
# REGION
# =============================================================================
#
# The provider in terraform/infra takes its region from var.region, so this mainly
# affects the aws CLI and the helper scripts. Keep it equal to `region` in
# terraform/infra/terraform.tfvars or the CLI and Terraform will disagree about which
# region they are looking at.

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# TERRAFORM
# =============================================================================
#
# TF_VAR_<name> sets the Terraform variable <name> without a tfvars file. Useful for a
# value you do not want on disk in tfvars, and the normal way CI supplies inputs.
#
# TF_VAR_domain_name=example.com

# THE REMOTE STATE BUCKET.
#
# The backend blocks under terraform/ deliberately name no bucket and no region:
#
#   region  the S3 backend reads AWS_REGION / AWS_DEFAULT_REGION above, the same way
#           the provider does — so the backend and the provider can never disagree
#           about which account's bucket to read while creating resources elsewhere.
#
#   bucket  has no environment-variable fallback in the backend. TF_CLI_ARGS_init below
#           is how it arrives: Terraform appends that string to EVERY `terraform init`,
#           so plain `terraform init` works with no flags once .env is loaded.
#
# Get the value once, after running terraform/bootstrap:
#   terraform -chdir=terraform/bootstrap output -raw state_bucket
#
# Set BOTH lines to the same bucket. TF_STATE_BUCKET is only for readability and for
# typing the explicit form by hand; TF_CLI_ARGS_init is what Terraform actually reads.
#
# TF_STATE_BUCKET=k8s-tfstate-123456789012
# TF_CLI_ARGS_init=-backend-config=bucket=k8s-tfstate-123456789012
#
# Prefer nothing implicit? Leave both unset and pass it per command instead:
#   terraform -chdir=terraform/infra init -backend-config="bucket=<name>"

# Quieter plan output in CI. Leave unset locally — the colour is useful.
# TF_IN_AUTOMATION=1

# =============================================================================
# WHAT DOES NOT BELONG IN THIS FILE
# =============================================================================
#
#   * the kubeadm join token       — minted on the node, read from SSM. See
#                                    terraform/modules/iam-irsa.
#   * the ECR pull credential      — `./script/aws-creds.sh` prompts for it and writes
#                                    it straight into the cluster as a Secret. It is
#                                    never stored on your machine.
#   * kubeconfig / cluster certs   — `aws eks update-kubeconfig` fetches those.
#   * database passwords           — Secrets Manager or SSM, read by the app at
#                                    runtime. Never a ConfigMap, never here.
