#!/usr/bin/env bash
# cloud-init user-data for a ${ROLE} node. RENDERED BY TERRAFORM — do not edit a
# copy of this on an instance; edit kubernetes/bootstrap/*.sh instead.
#
# This wrapper does three things and no more:
#   1. writes the bootstrap scripts to disk, so they survive for a manual re-run
#   2. exports the non-secret values Terraform substituted
#   3. runs the role script
#
# The scripts are embedded in QUOTED heredocs. The quoting is what makes that safe:
# <<'SENTINEL' suppresses every form of shell expansion, so the scripts' own $-vars,
# backticks and nested heredocs reach disk byte-for-byte.
#
# They used to be base64-encoded for the same reason, which worked but cost real
# space: base64 inflates by a third AND destroys compressibility, so it was paid for
# twice under the gzip this document needs to fit EC2's 16 KB user-data limit. Plain
# text gzips well and the limit stopped being close.
#
# NOTHING SECRET IS IN HERE. user-data is readable through IMDS by any process on
# the instance, including every container, so a join token placed here would be
# readable cluster-wide. Only a parameter NAME appears; the token is minted on the
# node and passed through SSM. See terraform/modules/iam.
set -euo pipefail

exec > >(tee -a /var/log/user-data.log) 2>&1
echo "[$(date -u +%FT%TZ)] user-data starting for role ${ROLE}"

# The AWS CLI is required by both roles — the control plane writes the join command
# to SSM and workers read it. Ubuntu's cloud images do not ship it.
if ! command -v aws >/dev/null 2>&1; then
  echo "installing awscli"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq unzip curl
  cd /tmp
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o awscliv2.zip
  unzip -q awscliv2.zip
  ./aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

BOOTSTRAP_DIR=/opt/k8s-bootstrap
mkdir -p "$BOOTSTRAP_DIR"

# install-containerd.sh must sit beside the role script: both `source` it by
# dirname of their own path.
#
# The sentinels are deliberately unguessable rather than EOF: these scripts contain
# their own heredocs, several of which end with a line reading exactly EOF, and the
# outer heredoc would stop at the first one and truncate the file.
cat >"$BOOTSTRAP_DIR/install-containerd.sh" <<'K8S_EMBED_INSTALL_9f3a2c'
${INSTALL_SCRIPT}
K8S_EMBED_INSTALL_9f3a2c

cat >"$BOOTSTRAP_DIR/${ROLE}.sh" <<'K8S_EMBED_ROLE_9f3a2c'
${ROLE_SCRIPT}
K8S_EMBED_ROLE_9f3a2c

chmod +x "$BOOTSTRAP_DIR"/*.sh

# ONE source of truth for the values, in systemd's EnvironmentFile format: bare
# KEY=value, no `export`, no quotes systemd would take literally.
cat >/etc/k8s-bootstrap.env <<ENVFILE
K8S_MINOR=${K8S_MINOR}
POD_CIDR=${POD_CIDR}
JOIN_PARAM=${JOIN_PARAM}
AWS_REGION=${AWS_REGION}
CNI_MANIFEST_URL=${CNI_MANIFEST_URL}
TOKEN_TTL=${TOKEN_TTL}
NODE_USER=${NODE_USER}
ENVFILE
chmod 0644 /etc/k8s-bootstrap.env

# The same values for interactive shells. `set -a` exports everything the sourced
# file defines, so one file serves both systemd and `sudo -i`.
cat >/etc/profile.d/k8s-bootstrap-env.sh <<'PROFILE'
set -a
. /etc/k8s-bootstrap.env
set +a
PROFILE
chmod 0644 /etc/profile.d/k8s-bootstrap-env.sh

set -a
. /etc/k8s-bootstrap.env
set +a

# ---------------------------------------------------------------- systemd units
#
# WHY THIS IS NOT JUST `exec "$BOOTSTRAP_DIR/$${ROLE}.sh"`.
#
# Six machines boot at once and the workers reach their join step minutes before the
# control plane has a token to give them. worker.sh polls for that, but a poll has a
# deadline — and when the deadline passes, a plain cloud-init run is simply over.
# Nothing retries. cloud-init does not re-run user-data on reboot either. The result
# is an instance that Terraform created successfully and that never joined anything,
# with no process left alive to notice.
#
# A oneshot service plus a timer fixes exactly that:
#
#   success -> RemainAfterExit keeps the unit ACTIVE, and starting an already-active
#              oneshot is a no-op, so the timer quietly stops having any effect.
#   failure -> the unit goes inactive(failed), OnUnitInactiveSec fires, and it runs
#              again a minute later. Forever, across reboots.
#
# Both scripts are idempotent by design — kubeadm init is skipped when admin.conf
# exists, kubeadm join when kubelet.conf does — which is what makes retrying safe.
cat >/etc/systemd/system/k8s-bootstrap.service <<UNIT
[Unit]
Description=Kubernetes node bootstrap (${ROLE})
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/k8s-bootstrap.env
ExecStart=$BOOTSTRAP_DIR/${ROLE}.sh
# The worker's own poll runs to 20 minutes; systemd must not kill it first.
TimeoutStartSec=0
UNIT

cat >/etc/systemd/system/k8s-bootstrap.timer <<'UNIT'
[Unit]
Description=Retry Kubernetes node bootstrap until it succeeds

[Timer]
OnBootSec=5s
# Measured from when the unit last went INACTIVE. A successful run stays active, so
# this never fires again; a failed one comes back in a minute.
OnUnitInactiveSec=60s
Unit=k8s-bootstrap.service

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now k8s-bootstrap.timer

echo "[$(date -u +%FT%TZ)] bootstrap handed to systemd; follow it with:"
echo "  journalctl -u k8s-bootstrap.service -f"
echo "[$(date -u +%FT%TZ)] user-data complete"
